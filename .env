IS_PRODUCTION=false

# ====日志====
# 终端
PRINT_CONSOLE_LOG_LEVEL=DEBUG # 等级
PRINT_CONSOLE_STREAM="ext://sys.stdout" # 输出文件路径
# 文件
PRINT_FILE_LOG_LEVEL=DEBUG # 等级
PRINT_FILE_LOG_ENCODING="utf-8" # 编码格式
PRINT_FILE_LOG_PATH="./logs" # 文件路径
PRINT_FILE_LOG_WHEN="midnight"
PRINT_FILE_LOG_INTERVAL=1
PRINT_FILE_LOG_BACKUPCOUNT=30

# ====数据库====
DB_CONNECT_STR="sqlite+aiosqlite:///./tests/integration/headline_backend_tests.db"