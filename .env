IS_PRODUCTION=false

# 日志

# 终端

# 等级
PRINT_CONSOLE_LOG_LEVEL=DEBUG
# 输出文件路径
PRINT_CONSOLE_STREAM="ext://sys.stdout"

# 文件

# 等级
PRINT_FILE_LOG_LEVEL=DEBUG
# 编码格式
PRINT_FILE_LOG_ENCODING="utf-8"
# 文件路径
PRINT_FILE_LOG_PATH="./logs"
PRINT_FILE_LOG_WHEN="midnight"
PRINT_FILE_LOG_INTERVAL=1
PRINT_FILE_LOG_BACKUPCOUNT=30